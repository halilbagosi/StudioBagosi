{
  "name": "studio-bagosi-cloudflare",
  "version": "1.0.0",
  "description": "Studio Bagosi website on Cloudflare Workers + D1 + R2",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create studio-bagosi-prod",
    "d1:setup": "wrangler d1 execute studio-bagosi-prod --file=./src/schemas/database.sql",
    "r2:create": "wrangler r2 bucket create studio-bagosi-images"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3"
  }
} 